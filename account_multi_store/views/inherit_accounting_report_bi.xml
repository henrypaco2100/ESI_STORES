<?xml version="1.0"?>
<odoo>
    <!-- inherit accounting report bi balancesheet -->
    <record id="sd_inherit_accounting_report_bi" model="ir.ui.view">
        <field name="name">sd.inherit.accounting.report.bi.balancesheet</field>
        <field name="model">accounting.report.bi</field>
        <field name="inherit_id" ref="bi_financial_pdf_reports.bi_financial_pdf_reports_form_account_report_custom"/>
        <field name="arch" type="xml">
            <field name="journal_ids" position="before">
                <field name="store_ids" groups="base_multi_store.group_multi_store"  widget="many2many_tags"/>
            </field>
        </field>
    </record>
    <!-- inherit accounting report bi profit loss-->
    <record id="sd_inherit_accounting_report_bi_profit_loss" model="ir.ui.view">
        <field name="name">sd.inherit.accounting.report.bi.profit.loss</field>
        <field name="model">accounting.report.bi</field>
        <field name="inherit_id" ref="bi_financial_pdf_reports.bi_financial_pdf_reports_form_account_report_custom_estado_resultado"/>
        <field name="arch" type="xml">
            <field name="journal_ids" position="before">
                <field name="store_ids" groups="base_multi_store.group_multi_store"  widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <!-- inherit accounting report bi general ledger-->
    <record id="sd_inherit_accounting_report_bi_general_ledger" model="ir.ui.view">
        <field name="name">sd.inherit.accounting.report.bi.general.ledger</field>
        <field name="model">accounting.report.bi</field>
        <field name="inherit_id" ref="bi_financial_pdf_reports.bi_financial_pdf_reports_form_general_ledger_custom_form"/>
        <field name="arch" type="xml">
            <field name="journal_ids" position="before">
                <field name="store_ids" groups="base_multi_store.group_multi_store"  widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>