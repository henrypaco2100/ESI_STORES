<?xml version="1.0"?>
<odoo>
    <record id="view_purchase_order_filter" model="ir.ui.view">
        <field name="name">purchase.order.filter.multi.store.esi</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="store_id" string="Sucursal" groups="esi_base_multi_store.group_multi_store"/>
            </field>
            <group position="inside">
                <filter name="store" string="Sucursal" context="{'group_by':'store_id'}" groups="esi_base_multi_store.group_multi_store"/>
            </group>
        </field>
    </record>
</odoo>
