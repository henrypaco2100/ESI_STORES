<?xml version="1.0"?>
<odoo>
    <!-- Añade el campo store_ids la vista view_template_property_form de product.template-->
    <record model="ir.ui.view" id="view_stock_product_template_group_form">
        <field name="name">stock.product.template.group.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="store_ids" widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>