<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automated_purchase_store_form_esi" model="ir.ui.view">
        <field name="name">automated.purchase.store.form.esi</field>
        <field name="model">automated.purchase</field>
        <field name="inherit_id" ref="esi_bi_automated_purchase_order.form_automate_purchase_order_workflow"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="store_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
            </field>
            <field name="st_almacen" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('store_id', '=', store_id)]</attribute>
            </field>
            <field name="purchase_journal" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('type', '=', 'purchase'), '|', ('store_id', '=', False), ('store_id', '=', store_id)]</attribute>
            </field>
            <field name="payment_journal" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('type', 'in', ('bank', 'cash')), '|', ('store_id', '=', False), ('store_id', '=', store_id)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_automated_purchase_store_tree_esi" model="ir.ui.view">
        <field name="name">automated.purchase.store.tree.esi</field>
        <field name="model">automated.purchase</field>
        <field name="inherit_id" ref="esi_bi_automated_purchase_order.tree_automate_purchase_order_workflow"/>
        <field name="arch" type="xml">
            <field name="name" position="after"><field name="store_id"/></field>
        </field>
    </record>
</odoo>
