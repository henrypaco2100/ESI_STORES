<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_automated_sale_store_form_esi" model="ir.ui.view">
        <field name="name">automated.sale.store.form.esi</field>
        <field name="model">automated.sale</field>
        <field name="inherit_id" ref="bi_automated_sale_order.form_automate_sale_order_workflow"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="store_id" required="1" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
            </field>
            <field name="st_almacen" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('store_id', '=', store_id)]</attribute>
            </field>
            <field name="sales_journal" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('type', '=', 'sale'), '|', ('store_id', '=', False), ('store_id', '=', store_id)]</attribute>
            </field>
            <field name="payment_journal" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('type', 'in', ('bank', 'cash')), '|', ('store_id', '=', False), ('store_id', '=', store_id)]</attribute>
            </field>
        </field>
    </record>

    <record id="view_automated_sale_store_tree_esi" model="ir.ui.view">
        <field name="name">automated.sale.store.tree.esi</field>
        <field name="model">automated.sale</field>
        <field name="inherit_id" ref="bi_automated_sale_order.tree_automate_sale_order_workflow"/>
        <field name="arch" type="xml">
            <field name="name" position="after"><field name="store_id"/></field>
        </field>
    </record>
</odoo>
